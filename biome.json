{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.vinext",
      "!!**/.next",
      "!!**/.wrangler",
      "!!**/.agents",
      "!!**/cloudflare-env.d.ts",
      "!!**/next-env.d.ts",
      "!!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["public/diagrams/*.svg"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components/portfolio/**",
                      "@/components/resume/**",
                      "@/components/print/**",
                      "@/components/analytics/**",
                      "@/components/admin/**",
                      "@/lib/portfolio/**",
                      "@/app/**"
                    ],
                    "message": "UI primitives must stay domain-agnostic (see docs/architecture.md)."
                  },
                  {
                    "group": ["next/navigation"],
                    "message": "UI primitives must not depend on routing (see docs/architecture.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/portfolio/**",
        "src/components/resume/**",
        "src/components/print/**",
        "src/components/analytics/**",
        "src/components/admin/**",
        "src/lib/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Lower layers must not import route/app code (see docs/architecture.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/components/**"],
                    "message": "lib must not depend on UI components (see docs/architecture.md)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAltText": "warn",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "useButtonType": "off",
        "useAriaPropsSupportedByRole": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "useConst": "error",
        "useImportType": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "warn"
      }
    }
  }
}
