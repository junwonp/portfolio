{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "vinext start",
    "deploy": "node scripts/guard-worker-branch.mjs production && CLOUDFLARE_CONFIG_PATH=wrangler.jsonc vinext-cloudflare deploy --config dist/server/wrangler.json --name portfolio",
    "deploy:development": "node scripts/guard-worker-branch.mjs development && CLOUDFLARE_CONFIG_PATH=wrangler.preview.jsonc vinext build && wrangler versions upload --config dist/server/wrangler.json --preview-alias develop",
    "start": "vinext start",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@types/mdx": "^2.0.14",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.15.0",
    "next": "16.2.9",
    "normalize.css": "^8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vite-plugin": "^1.42.3",
    "@cloudflare/workers-types": "^4.20260626.1",
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.0.0-beta.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.0.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.1",
    "react-server-dom-webpack": "^19.2.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "^5",
    "vinext": "1.0.0-beta.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  },
  "type": "module"
}
