{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "pnpm generate:media && vinext dev",
    "build": "pnpm generate:media && vinext build",
    "preview": "vinext start",
    "deploy": "node scripts/guard-worker-branch.mjs production && pnpm generate:media && CLOUDFLARE_CONFIG_PATH=wrangler.jsonc vinext-cloudflare deploy --prerender-all --config dist/server/wrangler.json --name portfolio",
    "deploy:development": "node scripts/guard-worker-branch.mjs development && pnpm generate:media && CLOUDFLARE_CONFIG_PATH=wrangler.preview.jsonc vinext build && wrangler versions upload --config dist/server/wrangler.json --preview-alias develop",
    "start": "vinext start",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "doctor": "react-doctor",
    "bench": "vitest bench --project node",
    "typecheck": "vitest run --typecheck --config vitest.typecheck.config.ts",
    "knip": "knip",
    "lighthouse": "lhci autorun",
    "mutation": "stryker run",
    "size": "size-limit --config size-limit.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --project node --run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "prepare": "git config core.hooksPath .githooks || true",
    "generate:media": "node scripts/generate-images.mjs && node scripts/generate-diagrams.mjs && node scripts/generate-project-images.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@types/mdx": "^2.0.14",
    "@vanilla-extract/css": "^1.21.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "normalize.css": "^8.0.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "^8.0.5",
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/vitest-plugin": "1.1.11",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@size-limit/preset-app": "^14.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.5.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "react-doctor": "^0.9.14",
    "react-server-dom-webpack": "^19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "sharp": "^0.35.4",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.131.2"
  },
  "type": "module"
}
