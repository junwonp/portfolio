{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "vinext start",
    "deploy": "node scripts/guard-worker-branch.mjs production && CLOUDFLARE_CONFIG_PATH=wrangler.jsonc vinext-cloudflare deploy --config dist/server/wrangler.json --name portfolio",
    "deploy:development": "node scripts/guard-worker-branch.mjs development && CLOUDFLARE_CONFIG_PATH=wrangler.preview.jsonc vinext build && wrangler versions upload --config dist/server/wrangler.json --preview-alias develop",
    "start": "vinext start",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@types/mdx": "^2.0.14",
    "@vanilla-extract/css": "^1.21.2",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "normalize.css": "^8.0.1",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.4.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "babel-plugin-react-compiler": "^1.0.0",
    "react-doctor": "^0.9.12",
    "react-server-dom-webpack": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.8",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
